# ==============================================================================
# AgriLog - Docker Compose Environment Variables
# Sao chép file này thành .env ở thư mục gốc (hoặc cấu hình agrilog-backend/.env)
# ==============================================================================

# Kết nối MongoDB (Mặc định dùng MongoDB Atlas Cloud theo kiến trúc thống nhất)
# MongoDB Atlas Cloud (Bắt buộc):
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/agrilog?retryWrites=true&w=majority
# (Tùy chọn) Chỉ khi dùng container local với lệnh 'docker compose --profile local-db up -d':
# MONGO_URI=mongodb://mongo:27017/agrilog

# Khóa JWT bí mật (Bắt buộc tối thiểu 32 ký tự)
JWT_SECRET=agrilog_jwt_production_secret_key_min_32_characters

# Địa chỉ Frontend và Backend API
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Email Service (Resend)
RESEND_API_KEY=

# Thời tiết (OpenWeatherMap)
OPENWEATHERMAP_API_KEY=

# Cloudflare R2 Storage (S3 Compatible)
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=agrilog
R2_PUBLIC_URL=

# Cổng thanh toán SePay
SEPAY_API_KEY=
SEPAY_ACC_NUMBER=
SEPAY_BANK=MBBank
SEPAY_ACC_NAME=

# [BẢO MẬT THANH TOÁN] Phương thức 1: API Key / Webhook Key
SEPAY_WEBHOOK_KEY=agrilog_webhook_key_2026

# [BẢO MẬT THANH TOÁN] Phương thức 2: Chữ ký HMAC-SHA256 Secret
SEPAY_WEBHOOK_SECRET=agrilog_hmac_secret_2026

# [BẢO MẬT THANH TOÁN] Phương thức 3: OAuth 2.0 Client Credentials
PAYMENT_CLIENT_ID=agrilog_payment_client
PAYMENT_CLIENT_SECRET=agrilog_payment_secret

# Cờ cho phép mô phỏng thanh toán (chỉ bật ở dev/test)
ALLOW_DEV_SIMULATE=false

