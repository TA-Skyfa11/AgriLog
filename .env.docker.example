# ==============================================================================
# AgriLog - Docker Compose Environment Variables
# Sao chép file này thành .env ở thư mục gốc (hoặc cấu hình agrilog-backend/.env)
# ==============================================================================

# Kết nối MongoDB (Mặc định dùng Atlas nếu có, hoặc dùng container local)
# MongoDB Atlas Cloud:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/agrilog?retryWrites=true&w=majority
# Hoặc MongoDB Container Local:
# MONGO_URI=mongodb://mongo:27017/agrilog

# Khóa JWT bí mật (Bắt buộc tối thiểu 32 ký tự)
JWT_SECRET=agrilog_jwt_production_secret_key_min_32_characters

# Địa chỉ Frontend và Backend API
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Email Service (Resend)
RESEND_API_KEY=

# Thời tiết (OpenWeatherMap)
OPENWEATHERMAP_API_KEY=

# Cloudflare R2 Storage (S3 Compatible)
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=agrilog
R2_PUBLIC_URL=

# Cổng thanh toán SePay
SEPAY_API_KEY=
SEPAY_ACC_NUMBER=
SEPAY_BANK=MBBank
SEPAY_ACC_NAME=
SEPAY_WEBHOOK_KEY=
