# ==============================================================================
# AgriLog - Docker Compose Environment Variables (Supabase Edition)
# Sao chép file này thành .env ở thư mục gốc (hoặc cấu hình agrilog-backend/.env)
# ==============================================================================

# Kết nối Cơ sở dữ liệu Supabase PostgreSQL
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_POOLER_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase API & Auth Configuration
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://[PROJECT_REF].supabase.co/auth/v1/.well-known/jwks.json

# Frontend Supabase Client
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Khóa JWT bí mật (Bắt buộc tối thiểu 32 ký tự)
JWT_SECRET=agrilog_jwt_production_secret_key_min_32_characters

# Địa chỉ Frontend và Backend API
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Email Service (Resend)
RESEND_API_KEY=

# Thời tiết (OpenWeatherMap)
OPENWEATHERMAP_API_KEY=

# Cloudflare R2 Storage (S3 Compatible)
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=agrilog
R2_PUBLIC_URL=

# SePay Payment Gateway
SEPAY_API_KEY=
SEPAY_ACC_NUMBER=
SEPAY_BANK=MBBank
SEPAY_ACC_NAME=
SEPAY_WEBHOOK_KEY=agrilog_webhook_key_2026
SEPAY_WEBHOOK_SECRET=
ALLOW_DEV_SIMULATE=false

# OneSignal Push Notification
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
NEXT_PUBLIC_ONESIGNAL_APP_ID=
