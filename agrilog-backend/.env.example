# ==============================================================================
# AgriLog Backend - Environment Variables Template
# Sao chép file này thành .env và cấu hình các giá trị thực tế trước khi chạy server
# ==============================================================================

# Cổng khởi chạy máy chủ Express (Mặc định: 5000)
PORT=5000

# Môi trường chạy ứng dụng (development | production)
NODE_ENV=development

# URL của ứng dụng Frontend (Next.js) - phục vụ cấu hình CORS và email liên kết
FRONTEND_URL=http://localhost:3000

# Kết nối cơ sở dữ liệu MongoDB (Bắt buộc)
# Local: mongodb://localhost:27017/agrilog
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/agrilog?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/agrilog

# Khóa bí mật JWT dùng để mã hóa token xác thực và phiên đăng nhập (BẮT BUỘC - Server sẽ dừng nếu thiếu)
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# Dịch vụ gửi email Resend - Dùng để gửi email xác thực, OTP và quên mật khẩu (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key

# OpenWeatherMap API Key - Cung cấp dữ liệu dự báo thời tiết nông nghiệp (https://openweathermap.org/api)
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key

# ==============================================================================
# Cloudflare R2 Storage - Lưu trữ ảnh/file đám mây (Chuẩn S3)
# ==============================================================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ENDPOINT=https://<your_account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
R2_BUCKET_NAME=agrilog
R2_PUBLIC_URL=

# ==============================================================================
# SePay Payment Gateway - Cổng thanh toán chuyển khoản quét mã QR (https://sepay.vn)
# ==============================================================================
SEPAY_API_KEY=your_sepay_api_key
SEPAY_ACC_NUMBER=your_bank_account_number
SEPAY_BANK=MBBank
SEPAY_ACC_NAME=YOUR_ACCOUNT_NAME
SEPAY_WEBHOOK_KEY=
