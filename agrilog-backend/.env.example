# ==============================================================================
# AgriLog Backend - Environment Variables Template (Supabase Edition)
# ==============================================================================

# Cổng khởi chạy máy chủ Express (Mặc định: 5000)
PORT=5000

# Môi trường chạy ứng dụng (development | production)
NODE_ENV=development

# URL của ứng dụng Frontend (Next.js) - phục vụ cấu hình CORS và email liên kết
FRONTEND_URL=http://localhost:3000

# Kết nối cơ sở dữ liệu Supabase PostgreSQL
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_POOLER_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase API & Auth Configuration
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://[PROJECT_REF].supabase.co/auth/v1/.well-known/jwks.json

# Khóa bí mật JWT dùng để mã hóa token xác thực và phiên đăng nhập (BẮT BUỘC - Server sẽ dừng nếu thiếu)
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# Dịch vụ gửi email Resend - Dùng để gửi email xác thực, OTP và quên mật khẩu (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key

# OpenWeatherMap API - Lấy dữ liệu thời tiết nông nghiệp (https://openweathermap.org)
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key

# Cloudflare R2 Storage - Lưu trữ hình ảnh nhật ký nông hộ
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=agrilog
R2_PUBLIC_URL=https://your-custom-domain.com

# Cổng thanh toán SePay - Quét mã QR chuyển khoản ngân hàng tự động (https://sepay.vn)
SEPAY_API_KEY=your_sepay_api_key
SEPAY_ACC_NUMBER=your_bank_account_number
SEPAY_BANK=MBBank
SEPAY_ACC_NAME=YOUR_ACCOUNT_NAME
SEPAY_WEBHOOK_KEY=agrilog_webhook_key_2026
SEPAY_WEBHOOK_SECRET=your_sepay_webhook_secret_key
ALLOW_DEV_SIMULATE=false

# OneSignal Push Notification - Gửi thông báo đẩy về thiết bị (https://onesignal.com)
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key
