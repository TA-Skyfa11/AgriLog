{
  "name": "agrilog-worker",
  "version": "1.0.0",
  "description": "Cloudflare Worker with Hyperdrive database connection for AgriLog",
  "main": "src/index.ts",
  "scripts": {
    "dev": "dotenv -e .dev.vars -- wrangler dev",
